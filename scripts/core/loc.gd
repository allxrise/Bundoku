static func t(key: String) -> String:
	var lang_dict: Dictionary = DATA.get(current_lang, DATA["tr"])
	if lang_dict.has(key):
		return str(lang_dict[key])
	if DATA["en"].has(key):
		return str(DATA["en"][key])
	return str(DATA["tr"].get(key, key))

static func quotes() -> Array:
	var lang_dict: Dictionary = DATA.get(current_lang, DATA["tr"])
	if lang_dict.has("quotes") and lang_dict["quotes"] is Array:
		return lang_dict["quotes"]
	return DATA["tr"]["quotes"]

static func get_short_code() -> String:
	for item in LANGUAGES:
		if item["code"] == current_lang:
			return str(item["short"])
	return current_lang.to_upper()
